# Copy to .env and adjust. Used by docker-compose and the server workspace.

# --- Database (docker-compose) ---
POSTGRES_USER=coinflow
POSTGRES_PASSWORD=coinflow
POSTGRES_DB=coinflow
POSTGRES_PORT=5434

# --- Server ---
PORT=4000
NODE_ENV=development
# Prisma connection string — matches the docker-compose values above
DATABASE_URL=postgresql://coinflow:coinflow@localhost:5434/coinflow?schema=public
# Secret for signing auth JWTs (change this)
JWT_SECRET=dev-only-change-me
# Origin allowed by CORS (the Vite dev server)
CLIENT_ORIGIN=http://localhost:5180

# --- Client (Vite) ---
# Leave blank in dev: requests go to /api and Vite proxies them to the server.
# Set to the deployed API origin for production builds.
VITE_API_BASE_URL=
